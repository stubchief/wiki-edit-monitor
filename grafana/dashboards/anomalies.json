            "panel-1": {
                "kind": "Panel",
                "spec": {
                    "data": {
                        "kind": "QueryGroup",
                        "spec": {
                            "queries": [
                                {
                                    "kind": "PanelQuery",
                                    "spec": {
                                        "hidden": false,
                                        "query": {
                                            "datasource": {
                                                "name": "clickhouse"
                                            },
                                            "group": "grafana-clickhouse-datasource",
                                            "kind": "DataQuery",
                                            "spec": {
                                                "editorType": "sql",
                                                "format": 1,
                                                "meta": {
                                                    "builderOptions": {
                                                        "columns": [],
                                                        "database": "",
                                                        "limit": 1000,
                                                        "mode": "list",
                                                        "queryType": "table",
                                                        "table": ""
                                                    }
                                                },
                                                "pluginVersion": "4.18.0",
                                                "queryType": "table",
                                                "rawSql": "WITH hourly AS (\r\n    SELECT\r\n        toStartOfHour(tick_start) AS hour,\r\n        wiki,\r\n        server_name,\r\n        namespace,\r\n        title,\r\n        sum(edit_count) AS edit_count\r\n    FROM agg_edits\r\n    GROUP BY hour, wiki, server_name, namespace, title\r\n),\r\nscored AS (\r\n    SELECT\r\n        hour,\r\n        wiki,\r\n        server_name,\r\n        namespace,\r\n        title,\r\n        edit_count,\r\n        avgIf(edit_count, hour < (SELECT max(hour) FROM hourly))\r\n            OVER (PARTITION BY wiki, title) AS baseline,\r\n        stddevPopIf(edit_count, hour < (SELECT max(hour) FROM hourly))\r\n            OVER (PARTITION BY wiki, title) AS stddev,\r\n        count() OVER (PARTITION BY wiki, title) AS observation_count\r\n    FROM hourly\r\n)\r\nSELECT\r\n    hour,\r\n    wiki,\r\n    server_name,\r\n    namespace,\r\n    title,\r\n    edit_count,\r\n    round(baseline, 2) AS baseline,\r\n    round(stddev, 2)   AS stddev,\r\n    round((edit_count - baseline) / stddev, 2) AS z_score\r\nFROM scored\r\nWHERE hour = (SELECT max(hour) FROM hourly)\r\n  AND observation_count >= 10\r\n  AND stddev > 0\r\n  AND z_score > 0\r\nORDER BY z_score DESC\r\nLIMIT 50"
                                            },
                                            "version": "v0"
                                        },
                                        "refId": "A"
                                    }
                                }
                            ],
                            "queryOptions": {},
                            "transformations": []
                        }
                    },
